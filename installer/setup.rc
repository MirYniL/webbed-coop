#include <windows.h>

1 RT_MANIFEST "setup.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,6,5,0
PRODUCTVERSION 1,6,5,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904B0"
        BEGIN
            VALUE "CompanyName", "Webbed Co-op contributors"
            VALUE "FileDescription", "Webbed Co-op Setup"
            VALUE "FileVersion", "1.6.5"
            VALUE "InternalName", "Webbed-Coop-Setup"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "Webbed-Coop-Setup.exe"
            VALUE "ProductName", "Webbed Co-op"
            VALUE "ProductVersion", "1.6.5"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0419, 1200
    END
END
